# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# service_role key (has full DB access — keep secret, never expose to client)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# anon/public key (used for client auth flows)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres connection string — Settings → Database → Connection string (URI)
# Required for: npm run seed
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Resend (transactional email) ─────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=salesmanager@primalnutrition.in

# ─── Meta Conversions API (server-side Purchase) ──────────────────────────────
# Pixel id (defaults to the live one). Generate a System User token in Meta
# Events Manager → Settings → Conversions API → Generate access token.
# META_CAPI_TEST_EVENT_CODE is optional — set it to see events in the Test
# Events tab while validating, then remove it for production.
META_PIXEL_ID=991258953663271
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_CAPI_API_VERSION=v21.0

# ─── Admin OTP login JWT ─────────────────────────────────────────────────────
# Secret used to sign admin session tokens. Use a long random string.
ADMIN_JWT_SECRET=replace_me

# ─── Cron (daily followup emails) ─────────────────────────────────────────────
# Long random string. The daily GitHub Action sends this as the bearer token
# to POST /cron/send-followups.
CRON_SECRET=replace_me

# ─── Razorpay (Phase C — not needed until payment integration) ────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Shiprocket (Phase C — not needed until shipping integration) ─────────────
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_password_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://primal-revamp-v2.netlify.app,https://primal-admin.netlify.app,http://localhost:5002,http://localhost:5173
